# Copie para .env e preencha. Nunca comite o .env de verdade.

# ─── Claude (Anthropic) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────
# Token de acesso do app (temporário no início; permanente depois)
WHATSAPP_TOKEN=
# ID do número de telefone (aba "API Setup" no painel do Meta)
WHATSAPP_PHONE_NUMBER_ID=
# Um texto secreto que VOCÊ inventa; usado na verificação do webhook
WHATSAPP_VERIFY_TOKEN=troque_por_um_segredo_qualquer

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
# Use a chave "service_role" (backend), NÃO a anon
SUPABASE_SERVICE_KEY=

# ─── Servidor ─────────────────────────────────────────────
PORT=3000
